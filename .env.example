# Copy this file to .env and fill in your values. .env is git-ignored.

# --- LLM for translation and summaries --------------------------------------
# auto: DeepSeek when DEEPSEEK_API_KEY is set, otherwise no translation or summaries.
# Options: auto | deepseek | ollama | none
LLM_PROVIDER=auto

# DeepSeek (https://platform.deepseek.com/api_keys). Only transcript text is sent.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_REASONING_EFFORT=none        # none | low | high | max
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MAX_TOKENS=16000

# Ollama, fully local: `ollama pull qwen3:8b`, then LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# --- Hugging Face (pyannote diarization model) -------------------------------
# Accept the terms at https://huggingface.co/pyannote/speaker-diarization-community-1
# and create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=
# HF_ENDPOINT=https://hf-mirror.com

# --- Hardware ----------------------------------------------------------------
DEVICE=auto                             # auto | cpu | cuda

# --- Speech recognition ------------------------------------------------------
# auto: nano on a CUDA GPU, routing otherwise
# routing: Whisper for English, SenseVoice for Mandarin and mixed turns
# nano: Fun-ASR-Nano for Mandarin, English and mixed turns (GPU)
ASR_PROFILE=auto
# FUNASR_NANO_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
# Use SenseVoice's text when Fun-ASR-Nano's has fewer than this share of its words (0 = off)
# NANO_FALLBACK_RATIO=0.6

# --- Speakers ----------------------------------------------------------------
# Speaker check: minimum cosine-similarity margin to move a turn (0 = off)
# SPEAKER_REASSIGN_MARGIN=0.1
# Target speaker extraction for overlapped speech: auto | on | off
# SPEAKER_EXTRACTION=auto
# Local extraction model folder (avg_model.pt, config.yaml); downloaded automatically if unset
# TSE_MODEL=/path/to/model

# --- Models (defaults) -------------------------------------------------------
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
# WHISPER_MODEL=large-v3-turbo          # small is much faster on CPU
# WHISPER_FALLBACK_MODEL=large-v3
# LANGID_WHISPER_MODEL=small
# SENSEVOICE_HUB=ms                     # ms = ModelScope, hf = Hugging Face

# --- Storage -----------------------------------------------------------------
# SPEAKERLENS_CACHE_DIR=~/.cache/speakerlens
